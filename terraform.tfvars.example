aws_region   = "us-east-1"
environment  = "dev"
project_name = "products-api"

lambda_runtime = "python3.12"
lambda_memory  = 256
lambda_timeout = 10

common_tags = {
  Environment = "dev"
  ManagedBy   = "terraform"
  Project     = "products-api"
  Owner       = "devops"
}

cors_allow_origin = "*"
